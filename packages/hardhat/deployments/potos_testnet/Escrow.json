ateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"}],\"name\":\"confirm\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"seller\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"deadline\",\"type\":\"uint256\"},{\"internalType\":\"string\",\"name\":\"description\",\"type\":\"string\"}],\"name\":\"createOrder\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"}],\"name\":\"deposit\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"}],\"name\":\"dispute\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"}],\"name\":\"getOrder\",\"outputs\":[{\"components\":[{\"internalType\":\"address\",\"name\":\"buyer\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"seller\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"deadline\",\"type\":\"uint256\"},{\"internalType\":\"enum Escrow.Status\",\"name\":\"status\",\"type\":\"uint8\"},{\"internalType\":\"string\",\"name\":\"description\",\"type\":\"string\"}],\"internalType\":\"struct Escrow.Order\",\"name\":\"\",\"type\":\"tuple\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"orderCount\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"}],\"name\":\"refund\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"},{\"internalType\":\"bool\",\"name\":\"sellerWins\",\"type\":\"bool\"}],\"name\":\"resolve\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/Escrow.sol\":\"Escrow\"},\"evmVersion\":\"paris\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\",\"useLiteralContent\":true},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[]},\"sources\":{\"contracts/Escrow.sol\":{\"content\":\"// SPDX-License-Identifier: MIT\\npragma solidity >=0.8.0 <0.9.0;\\n\\n// \\u53ea\\u58f0\\u660e\\u6211\\u4eec\\u8981\\u7528\\u7684\\u4e09\\u4e2a\\u51fd\\u6570\\u3002Escrow \\u901a\\u8fc7\\u8fd9\\u4e2a\\u63a5\\u53e3\\u53bb\\u8c03\\u7528\\u4efb\\u4f55 ERC20 \\u5408\\u7ea6\\u3002\\ninterface IERC20 {\\n    function transfer(address to, uint256 value) external returns (bool);\\n    function transferFrom(address from, address to, uint256 value) external returns (bool);\\n    function balanceOf(address account) external view returns (uint256);\\n}\\n\\ncontract Escrow {\\n    // ---------- \\u72b6\\u6001\\u673a ----------\\n    enum Status { Created, Paid, Completed, Refunded, Disputed }\\n\\n    struct Order {\\n        address buyer;\\n        address seller;\\n        address token;      // \\u7528\\u54ea\\u79cd ERC20 \\u7ed3\\u7b97\\n        uint256 amount;    // \\u6700\\u5c0f\\u5355\\u4f4d\\n        uint256 deadline;  // unix \\u65f6\\u95f4\\u6233\\uff0c\\u79d2\\n        Status status;\\n        string description;\\n    }\\n\\n    // ---------- \\u5b58\\u50a8 ----------\\n    address public arbiter;\\n    uint256 public orderCount;\\n    mapping(uint256 => Order) private _orders;\\n\\n    // ---------- \\u4e8b\\u4ef6 ----------\\n    event OrderCreated(uint256 indexed id, address indexed buyer, address indexed seller, address token, uint256 amount, uint256 deadline);\\n    event OrderPaid(uint256 indexed id);\\n    event OrderCompleted(uint256 indexed id);\\n    event OrderRefunded(uint256 indexed id);\\n    event OrderDisputed(uint256 indexed id, address by);\\n    event OrderResolved(uint256 indexed id, bool sellerWins);\\n\\n    // ---------- \\u4fee\\u9970\\u5668 ----------\\n    modifier onlyArbiter() {\\n        require(msg.sender == arbiter, \\\"Escrow: caller is not the arbiter\\\");\\n        _;\\n    }\\n\\n    modifier onlyBuyer(uint256 id) {\\n        require(msg.sender == _orders[id].buyer, \\\"Escrow: caller is not the buyer\\\");\\n        _;\\n    }\\n\\n    modifier inStatus(uint256 id, Status s) {\\n        require(_orders[id].status == s, \\\"Escrow: wrong status\\\");\\n        _;\\n    }\\n\\n    constructor(address _arbiter) {\\n        require(_arbiter != address(0), \\\"Escrow: arbiter is the zero address\\\");\\n        arbiter = _arbiter;\\n    }\\n\\n    function getOrder(uint256 id) public view returns (Order memory) {\\n        require(id < orderCount, \\\"Escrow: order does not exist\\\");\\n        return _orders[id];\\n    }\\n\\n    // ---------- TODO 1\\uff1a\\u521b\\u5efa\\u8ba2\\u5355 ----------\\n    // \\u8981\\u6c42\\uff1aseller \\u4e0d\\u80fd\\u662f\\u96f6\\u5730\\u5740\\u3001\\u4e0d\\u80fd\\u662f\\u81ea\\u5df1\\uff1bamount \\u5927\\u4e8e 0\\uff1bdeadline \\u5fc5\\u987b\\u5728\\u672a\\u6765\\uff1b\\n    // \\u8ba2\\u5355 id \\u4e3a\\u5f53\\u524d orderCount\\uff0c\\u5199\\u5165 _orders\\uff0corderCount \\u52a0\\u4e00\\uff1b\\n    // buyer \\u662f msg.sender\\uff0c\\u72b6\\u6001 Created\\uff1b\\u53d1\\u51fa OrderCreated\\uff1b\\u8fd4\\u56de id\\u3002\\n    function createOrder(address seller, address token, uint256 amount, uint256 deadline, string memory description) public returns (uint256) {\\n        require(seller != address(0), \\\"Escrow: seller is zero address\\\");\\n        require(msg.sender != seller, \\\"Escrow: cannot create order to yourself\\\");\\n        require(amount > 0, \\\"Escrow: amount must be positive\\\");\\n        require(deadline > block.timestamp, \\\"Escrow: deadline must be in future\\\");\\n        uint256 orderId = orderCount;\\n        _orders[orderId] = Order({\\n            buyer: msg.sender,\\n            seller: seller,\\n            token: token,\\n            amount: amount,\\n            deadline: deadline,\\n            status: Status.Created,\\n            description: description\\n        });\\n        orderCount++;\\n        emit OrderCreated(orderId, msg.sender, seller, token, amount, deadline);\\n        return orderId;\\n    }\\n\\n    // ---------- TODO 2\\uff1a\\u4e70\\u5bb6\\u4ed8\\u6b3e ----------\\n    // \\u8981\\u6c42\\uff1a\\u53ea\\u6709\\u4e70\\u5bb6\\u3001\\u53ea\\u5728 Created \\u72b6\\u6001\\uff08\\u7528\\u4fee\\u9970\\u5668\\uff09\\uff1b\\n    // \\u5148\\u628a\\u72b6\\u6001\\u6539\\u4e3a Paid\\uff0c\\u518d\\u8c03\\u7528\\u4ee3\\u5e01\\u7684 transferFrom \\u628a amount \\u4ece\\u4e70\\u5bb6\\u8f6c\\u5230\\u672c\\u5408\\u7ea6\\uff08address(this)\\uff09\\uff1b\\n    // transferFrom \\u8fd4\\u56de false \\u8981 revert\\uff1b\\u53d1\\u51fa OrderPaid\\u3002\\n    // \\u63d0\\u793a\\uff1aIERC20(o.token).transferFrom(...)\\u3002\\u60f3\\u6e05\\u695a\\u4ee3\\u5e01\\u5408\\u7ea6\\u770b\\u5230\\u7684 msg.sender \\u662f\\u8c01\\u3002\\n    function deposit(uint256 id) public onlyBuyer(id) inStatus(id, Status.Created) {\\n        _orders[id].status = Status.Paid;\\n        IERC20(_orders[id].token).transferFrom(msg.sender, address(this), _orders[id].amount);\\n        emit OrderPaid(id);\\n    }\\n\\n    // ---------- TODO 3\\uff1a\\u4e70\\u5bb6\\u786e\\u8ba4\\u6536\\u8d27 ----------\\n    // \\u8981\\u6c42\\uff1a\\u53ea\\u6709\\u4e70\\u5bb6\\u3001\\u53ea\\u5728 Paid \\u72b6\\u6001\\uff1b\\u72b6\\u6001\\u6539\\u4e3a Completed\\uff1b\\u4ee3\\u5e01\\u8f6c\\u7ed9\\u5356\\u5bb6\\uff1b\\u53d1\\u51fa OrderCompleted\\u3002\\n    function confirm(uint256 id) public onlyBuyer(id) inStatus(id, Status.Paid) {\\n        _orders[id].status = Status.Completed;\\n        IERC20(_orders[id].token).transfer(_orders[id].seller, _orders[id].amount);\\n        emit OrderCompleted(id);\\n    }\\n\\n    // ---------- TODO 4\\uff1a\\u8d85\\u671f\\u9000\\u6b3e ----------\\n    // \\u8981\\u6c42\\uff1a\\u53ea\\u6709\\u4e70\\u5bb6\\u3001\\u53ea\\u5728 Paid \\u72b6\\u6001\\uff1bblock.timestamp \\u5fc5\\u987b\\u5927\\u4e8e deadline\\uff1b\\n    // \\u72b6\\u6001\\u6539\\u4e3a Refunded\\uff1b\\u4ee3\\u5e01\\u9000\\u56de\\u4e70\\u5bb6\\uff1b\\u53d1\\u51fa OrderRefunded\\u3002\\n    function refund(uint256 id) public onlyBuyer(id) inStatus(id, Status.Paid) {\\n        require(block.timestamp > _orders[id].deadline, \\\"Escrow: deadline not reached\\\");\\n        _orders[id].status = Status.Refunded;\\n        IERC20(_orders[id].token).transfer(msg.sender, _orders[id].amount);\\n        emit OrderRefunded(id);\\n    }\\n\\n    // ---------- TODO 5\\uff1a\\u53d1\\u8d77\\u4e89\\u8bae ----------\\n    // \\u8981\\u6c42\\uff1a\\u53ea\\u5728 Paid \\u72b6\\u6001\\uff1b\\u8c03\\u7528\\u8005\\u5fc5\\u987b\\u662f\\u4e70\\u5bb6\\u6216\\u5356\\u5bb6\\uff1b\\u72b6\\u6001\\u6539\\u4e3a Disputed\\uff1b\\u53d1\\u51fa OrderDisputed\\u3002\\n    function dispute(uint256 id) public inStatus(id, Status.Paid) {\\n        require(msg.sender == _orders[id].buyer || msg.sender == _orders[id].seller, \\\"Escrow: caller is not buyer or seller\\\");\\n        _orders[id].status = Status.Disputed;\\n        emit OrderDisputed(id, msg.sender);\\n    }\\n\\n    // ---------- TODO 6\\uff1a\\u4ef2\\u88c1 ----------\\n    // \\u8981\\u6c42\\uff1a\\u53ea\\u6709\\u4ef2\\u88c1\\u4eba\\u3001\\u53ea\\u5728 Disputed \\u72b6\\u6001\\uff1b\\n    // sellerWins \\u4e3a true \\u5219\\u72b6\\u6001 Completed\\u3001\\u4ee3\\u5e01\\u7ed9\\u5356\\u5bb6\\uff0c\\u5426\\u5219\\u72b6\\u6001 Refunded\\u3001\\u4ee3\\u5e01\\u9000\\u4e70\\u5bb6\\uff1b\\n    // \\u53d1\\u51fa OrderResolved\\u3002\\n    function resolve(uint256 id, bool sellerWins) public onlyArbiter inStatus(id, Status.Disputed) {\\n        if (sellerWins) {\\n            _orders[id].status = Status.Completed;\\n            IERC20(_orders[id].token).transfer(_orders[id].seller, _orders[id].amount);\\n        } else {\\n            _orders[id].status = Status.Refunded;\\n            IERC20(_orders[id].token).transfer(_orders[id].buyer, _orders[id].amount);\\n        }\\n        emit OrderResolved(id, sellerWins);\\n    }\\n}\\n\",\"keccak256\":\"0x90b2968a75090c8aed5ba9baff0f47072d21ad948d9f3bca2d01e3c9324c555b\",\"license\":\"MIT\"}},\"version\":1}",
